# Supabase (Dashboard → Project Settings → API)
SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (client-safe) — formerly "anon key"
SUPABASE_ANON_KEY=sb_publishable_xxx
# Secret key (backend only, never expose) — formerly "service_role key"
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx

# Server
PORT=3000
NODE_ENV=development

# CORS - frontend URL
FRONTEND_URL=http://localhost:8100

# Expiry notification thresholds (days)
EXPIRY_THRESHOLDS=90,60,30,14,7,1,0

# Suspicious activity
MAX_SCANS_PER_HOUR=10
MAX_INVALID_ATTEMPTS=5
